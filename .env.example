# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DISCORD_BOT_TOKEN: Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# DISCORD_CHANNEL_ID: Specific channel ID where the bot counts 'e' (Default: 1542084929171492955)
DISCORD_CHANNEL_ID="1542084929171492955"

# DISCORD_CLIENT_ID: Discord Application ID for slash commands registration (Optional)
DISCORD_CLIENT_ID=""

# NEON / Lakebase Postgres Connection Strings
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_API_KEY=
NEON_PROJECT_ID="divine-lake-38992570"

